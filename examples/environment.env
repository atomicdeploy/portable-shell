# Demonstration file: no real credentials
# Runtime
APP_NAME="Workbench"
APP_ENV=development
DEBUG=false # Enable only while diagnosing
PORT=8080
HOST=127.0.0.1

# Storage
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workspace
DB_USER=operator
DB_PASSWORD="example-only"
POOL_SIZE=8

# Network and delivery
# MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=2525
TIMEOUT=30
RETRIES=3
REGION=local
LOG_LEVEL=info
LOG_LEVEL=debug # Duplicate intentionally retained
WELCOME="Hello,
world!"
COLOR=auto
CACHE_ENABLED=true
CACHE_TTL=300
WORKERS=4
