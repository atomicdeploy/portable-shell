set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR xtensa)
if(NOT CMAKE_C_COMPILER)
  set(CMAKE_C_COMPILER xtensa-lx106-elf-gcc)
endif()
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(PORTABLE_SHELL_BUILD_HOST OFF CACHE BOOL "" FORCE)
set(PORTABLE_SHELL_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(PORTABLE_SHELL_COMPACT ON CACHE BOOL "" FORCE)
set(PORTABLE_SHELL_COMPILER_RT ON CACHE BOOL "" FORCE)
