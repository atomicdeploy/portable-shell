# Cross-platform build-time dependency audit; no shell, Python or host execution.
cmake_minimum_required(VERSION 3.16)
execute_process(COMMAND "${NM}" -g -P "${ARCHIVE}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE definitions ERROR_VARIABLE errors)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "Cannot inspect archive definitions: ${errors}")
endif()
set(references "${definitions}")
string(REPLACE "\n" ";" lines "${definitions}")
set(defined)
foreach(line IN LISTS lines)
  if(line MATCHES "^([^ \t]+)[ \t]+([A-Za-z])([ \t\r]|$)")
    set(definition_name "${CMAKE_MATCH_1}")
    set(definition_type "${CMAKE_MATCH_2}")
    if(NOT definition_type MATCHES "^[Uwv]$")
      list(APPEND defined "${definition_name}")
    endif()
  endif()
endforeach()
set(allowed)
if(USE_LIBC)
  set(allowed memcpy memmove memset memcmp strlen strcmp strstr)
  foreach(symbol IN LISTS allowed)
    if(symbol IN_LIST defined OR "_${symbol}" IN_LIST defined)
      message(FATAL_ERROR "Libc mode must not override host function ${symbol}")
    endif()
  endforeach()
  # Hosted builds may retain the toolchain's stack protection/probing and fortified
  # memory calls. No allocator, terminal, network or filesystem symbols are allowed.
  list(APPEND allowed __stack_chk_fail __stack_chk_guard __chkstk __chkstk_ms ___chkstk_ms
    __memcpy_chk __memmove_chk __memset_chk)
elseif(NOT PROVIDE_MEMORY)
  set(allowed memcpy memmove memset memcmp)
endif()
string(REPLACE "\n" ";" lines "${references}")
set(external)
foreach(line IN LISTS lines)
  if(line MATCHES "^([^ \t]+)[ \t]+[Uwv]([ \t\r]|$)")
    set(symbol "${CMAKE_MATCH_1}")
    if(NOT symbol IN_LIST defined)
      # Darwin/32-bit COFF prepend one underscore; PE imports may use __imp_.
      string(REGEX REPLACE "^__imp_" "" normalized "${symbol}")
      # Strip exactly one platform prefix. Older CMake regex replacement can
      # re-match ^ after each replacement, eating all leading underscores.
      string(SUBSTRING "${normalized}" 0 1 first_character)
      if(first_character STREQUAL "_")
        string(SUBSTRING "${normalized}" 1 -1 normalized)
      endif()
      if(NOT symbol IN_LIST allowed AND NOT normalized IN_LIST allowed)
        message(FATAL_ERROR "Unexpected external symbol ${symbol} in ${ARCHIVE}")
      endif()
      list(APPEND external "${symbol}")
    endif()
  endif()
endforeach()
list(REMOVE_DUPLICATES external)
message(STATUS "PortableShell symbol audit passed; permitted externals: [${external}]")
