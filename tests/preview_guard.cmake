# Negative integration checks use disposable copies, never the committed files.
cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED BUILD_DIR)
  set(BUILD_DIR "${root}/build/previews")
endif()
if(NOT DEFINED EXPECTED_DIR)
  set(EXPECTED_DIR "${BUILD_DIR}/guard-expected")
endif()
set(expected "${EXPECTED_DIR}")
file(MAKE_DIRECTORY "${expected}")
foreach(case png svg missing animation recording)
  file(GLOB captures "${root}/previews/*.png" "${root}/previews/*.svg"
    "${root}/previews/*.psrec" "${root}/previews/Agave-LICENSE.txt")
  foreach(capture IN LISTS captures)
    file(COPY "${capture}" DESTINATION "${expected}")
  endforeach()
  set(pattern "workspace\\.(png|svg)")
  if(case STREQUAL "animation")
    file(APPEND "${expected}/terminal-session.svg" "stale-animation-fixture")
    set(pattern "terminal-session\\.svg")
  elseif(case STREQUAL "recording")
    file(APPEND "${expected}/terminal-session.psrec" "stale-recording-fixture")
    set(pattern "terminal-session\\.psrec")
  elseif(case STREQUAL "missing")
    file(REMOVE "${expected}/workspace.png")
  else()
    file(APPEND "${expected}/workspace.${case}" "stale-image-fixture")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DBUILD_DIR=${BUILD_DIR}" "-DEXPECTED_DIR=${expected}"
    -P "${root}/tools/rebuild-previews.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(result EQUAL 0 OR NOT "${out}${err}" MATCHES "Stale previews:.*${pattern}")
    message(FATAL_ERROR "Preview ${case} corruption was not correctly rejected: ${out}${err}")
  endif()
endforeach()
message(STATUS "Stale PNG, SVG, animation, recording and missing image were all rejected")
