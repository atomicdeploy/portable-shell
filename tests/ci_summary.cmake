cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(tmp "${root}/build/summary-test")
file(MAKE_DIRECTORY "${tmp}")
set(ENV{STEPS_JSON} "{\"build\":{\"outcome\":\"success\"},\"tests\":{\"outcome\":\"failure\"},\"publish\":{\"outcome\":\"skipped\"}}")
set(ENV{JOB_STATUS} "failure")
set(ENV{BUILD_CONFIGURATION} "<script>|unsafe&text")
set(ENV{GITHUB_STEP_SUMMARY} "${tmp}/github.md")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DREPORT_DIR=${tmp}" -P "${root}/tools/ci/summary.cmake" COMMAND_ERROR_IS_FATAL ANY)
file(READ "${tmp}/summary.md" result)
foreach(expected "❌ PortableShell — failure" "tests | failure" "publish | skipped" "&lt;script&gt;&#124;unsafe&amp;text" "No binary produced")
  string(FIND "${result}" "${expected}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Summary omitted ${expected}")
  endif()
endforeach()
file(READ "${tmp}/github.md" published)
string(FIND "${published}" "${result}" found)
if(found EQUAL -1)
  message(FATAL_ERROR "GitHub summary did not receive the report")
endif()
message(STATUS "Failure, skipped steps, missing artifacts, escaping and summary append verified")
