cmake_minimum_required(VERSION 3.20)
function(check result expected label)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "${label}: ${result}, expected ${expected}")
  endif()
endfunction()
execute_process(COMMAND "${HOST}" -- run "${CHILD}" "" "a b" "a\"b" "tail\\" "|literal"
  OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE result TIMEOUT 10)
check("${result}" 0 "direct argv")
foreach(marker "tty:0" "arg:0:" "arg:3:a b" "arg:3:a\"b" "arg:5:tail\\" "arg:8:|literal")
  string(FIND "${output}" "${marker}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Missing ${marker}: ${output}")
  endif()
endforeach()
if(NOT error MATCHES "stderr-marker" OR output MATCHES "stderr-marker")
  message(FATAL_ERROR "stderr not preserved: ${error} / ${output}")
endif()
execute_process(COMMAND "${HOST}" -- "${CHILD}" fail RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
check("${result}" 7 "fallback exit code")
execute_process(COMMAND "${HOST}" --no-exec -- "${CHILD}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
check("${result}" 2 "execution opt-out")
execute_process(COMMAND "${HOST}" -- run portable-shell-missing-executable RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
check("${result}" 127 "missing program")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/process-input.txt" "stdin-marker\n")
foreach(mode run pty)
  execute_process(COMMAND "${HOST}" -- "${mode}" "${CHILD}" input
    INPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/process-input.txt" OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE result TIMEOUT 15)
  check("${result}" 0 "${mode} stdin")
  if(NOT output MATCHES "input:stdin-marker")
    message(FATAL_ERROR "${mode} stdin: ${output} / ${error}")
  endif()
endforeach()
execute_process(COMMAND "${HOST}" -- pty "${CHILD}" OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE result TIMEOUT 15)
check("${result}" 0 "PTY")
if(NOT output MATCHES "tty:1" OR NOT output MATCHES "stderr-marker")
  message(FATAL_ERROR "PTY allocation/merged output: ${output} / ${error}")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/process-handoff.txt" "run '${CHILD}' input\nstdin-handoff\n")
execute_process(COMMAND "${HOST}" --batch INPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/process-handoff.txt"
  OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE result TIMEOUT 10)
check("${result}" 0 "command stdin handoff")
if(NOT output MATCHES "input:stdin-handoff")
  message(FATAL_ERROR "Parent consumed child stdin: ${output} / ${error}")
endif()
message(STATUS "Real process argv, stdin, stdout/stderr, exit codes and PTY checks passed")
