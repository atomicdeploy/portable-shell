cmake_minimum_required(VERSION 3.20)
set(root "${CMAKE_CURRENT_BINARY_DIR}/language-fixture")
file(MAKE_DIRECTORY "${root}/directory with spaces")
file(COPY "${CHILD}" DESTINATION "${root}")
get_filename_component(child_name "${CHILD}" NAME)
set(CHILD "./${child_name}")
function(run line expected pattern)
  execute_process(COMMAND "${HOST}" --exec --batch --command "${line}"
    WORKING_DIRECTORY "${root}" OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE result TIMEOUT 15)
  if(NOT "${result}" STREQUAL "${expected}" OR NOT "${output}" MATCHES "${pattern}")
    message(FATAL_ERROR "Command ${line}: result=${result}, expected=${expected}, output=${output}, stderr=${error}")
  endif()
endfunction()
run("setenv PS_LANGUAGE_VALUE 'two words'; echo \"$PS_LANGUAGE_VALUE\"" 0 "two words")
run("echo '$PS_LANGUAGE_VALUE' '#literal' 'a|b'" 0 "\\$PS_LANGUAGE_VALUE #literal a\\|b")
run("'${CHILD}' fail && echo SHOULD_NOT || echo recovered" 0 "recovered")
run("'${CHILD}' fail; echo $?" 0 "7")
run("'${CHILD}' fail | '${CHILD}' count; echo $?" 0 "0")
run("echo alpha > 'out.txt'; echo beta >> 'out.txt'" 0 "")
file(READ "${root}/out.txt" text)
if(NOT text MATCHES "alpha[\r\n]+beta")
  message(FATAL_ERROR "Builtin append redirection: ${text}")
endif()
run("'${CHILD}' input < 'out.txt' > 'read.txt' 2> 'error.txt'" 0 "")
file(READ "${root}/read.txt" text)
if(NOT text MATCHES "input:alpha")
  message(FATAL_ERROR "stdin redirection: ${text}")
endif()
run("'${CHILD}' > 'merged.txt' 2>&1" 0 "")
file(READ "${root}/merged.txt" text)
if(NOT text MATCHES "stderr-marker" OR NOT text MATCHES "tty:")
  message(FATAL_ERROR "merged streams: ${text}")
endif()
run("'${CHILD}' produce | '${CHILD}' count" 0 "count:200000")
run("echo pipeline | '${CHILD}' input" 0 "input:pipeline")
run("pwd | '${CHILD}' input" 0 "input:")
run("run '${CHILD}' produce | run '${CHILD}' count > 'count.txt'" 0 "")
file(READ "${root}/count.txt" text)
if(NOT text MATCHES "count:200000")
  message(FATAL_ERROR "run pipeline: ${text}")
endif()
run("cd 'directory with spaces'; pwd; cd -; pwd" 0 "directory with spaces")
file(WRITE "${root}/script.psh" "setenv PS_LANGUAGE_SCRIPT 'script value'\necho \"$PS_LANGUAGE_SCRIPT\"\n")
run("source script.psh; env PS_LANGUAGE_SCRIPT" 0 "script value")
run("exit 23; echo SHOULD_NOT" 23 "")
run("'${CHILD}' fail; exit" 7 "")
run("echo no > 'untouched.txt' &&" 2 "missing command")
if(EXISTS "${root}/untouched.txt")
  message(FATAL_ERROR "Syntax error opened a redirection file")
endif()
run("nonexistent_portable_shell_command | '${CHILD}' count" 127 "")
run("echo no & echo no" 2 "unsupported")
run("echo $(no)" 2 "unsupported")
file(WRITE "${root}/recursive.psh" "source recursive.psh\n")
run("source recursive.psh" 2 "")
message(STATUS "Native command language, large pipes, environment, redirection and source checks passed")
