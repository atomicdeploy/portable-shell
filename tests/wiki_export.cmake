cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(OUTPUT_DIR "${root}/build/wiki-export-test")
include("${root}/tools/export-wiki.cmake")
foreach(page IN LISTS pages)
  get_filename_component(name "${page}" NAME)
  file(READ "${OUTPUT_DIR}/${name}" exported)
  if(exported MATCHES "\\]\\(\\.\\./")
    message(FATAL_ERROR "Unresolved repository link in ${name}")
  endif()
endforeach()
file(READ "${OUTPUT_DIR}/Gallery.md" gallery)
foreach(expected IN ITEMS
    "https://raw.githubusercontent.com/atomicdeploy/portable-shell/main/previews/env-values.png"
    "](Animated-previews)"
    "https://raw.githubusercontent.com/atomicdeploy/portable-shell/main/previews/terminal-session.svg")
  string(FIND "${gallery}" "${expected}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Missing gallery link: ${expected}")
  endif()
endforeach()
file(READ "${OUTPUT_DIR}/Animated-previews.md" guide)
if(NOT guide MATCHES "https://github.com/atomicdeploy/portable-shell/blob/main/previews/Agave-LICENSE.txt")
  message(FATAL_ERROR "Font attribution link must resolve in the repository")
endif()
message(STATUS "Wiki page, image, animation and source links verified")
