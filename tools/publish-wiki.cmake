# Publish only into an existing clean wiki checkout. No reset, force, or deletion.
cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED WIKI_DIR OR NOT EXISTS "${WIKI_DIR}/.git")
  message(FATAL_ERROR "Set WIKI_DIR to an initialized wiki Git checkout")
endif()
find_package(Git REQUIRED)
function(git_run)
  execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN} WORKING_DIRECTORY "${WIKI_DIR}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Wiki git operation failed (${result}); no force-push attempted")
  endif()
endfunction()
execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain WORKING_DIRECTORY "${WIKI_DIR}" OUTPUT_VARIABLE changes RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT changes STREQUAL "")
  message(FATAL_ERROR "Wiki checkout must be clean; preserve/review its existing changes first")
endif()
git_run(pull --ff-only)
set(OUTPUT_DIR "${WIKI_DIR}")
include("${CMAKE_CURRENT_LIST_DIR}/export-wiki.cmake")
foreach(page IN LISTS pages)
  get_filename_component(name "${page}" NAME)
  git_run(add -- "${name}")
endforeach()
execute_process(COMMAND "${GIT_EXECUTABLE}" diff --cached --quiet WORKING_DIRECTORY "${WIKI_DIR}" RESULT_VARIABLE changed)
if(changed EQUAL 1)
  git_run(commit -m "Publish reviewed PortableShell documentation")
  git_run(push origin HEAD)
elseif(NOT changed EQUAL 0)
  message(FATAL_ERROR "Unable to inspect wiki changes")
endif()
