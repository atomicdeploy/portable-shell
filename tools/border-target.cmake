function(ps_border_check_target target)
  add_executable(${target} "${root}/tests/border_checks.c" "${root}/tests/render.c" "${root}/src/portable_shell.c")
  target_include_directories(${target} PRIVATE "${root}/include")
  target_compile_features(${target} PRIVATE c_std_99)
  target_compile_definitions(${target} PRIVATE PS_REPLAY_ONLY PS_REPLAY_ATTRIBUTES W=80 H=24 PS_REPLAY_SVG_CAPACITY=800000 ${ARGN})
  if(MSVC)
    target_compile_options(${target} PRIVATE /UNDEBUG /W4)
  else()
    target_compile_options(${target} PRIVATE -UNDEBUG -Wall -Wextra -Werror)
  endif()
  set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
endfunction()
ps_border_check_target(border_checks)
