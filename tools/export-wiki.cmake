cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED OUTPUT_DIR)
  set(OUTPUT_DIR "${root}/build/wiki")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(GLOB pages "${root}/docs/wiki/*.md")
foreach(page IN LISTS pages)
  file(READ "${page}" text)
  # The wiki has a separate Git root. Resolve repository assets and source links
  # before converting sibling Markdown pages into native wiki links.
  string(REGEX MATCHALL "\\(\\.\\./[^ )]+\\)" repo_links "${text}")
  foreach(link IN LISTS repo_links)
    string(REGEX REPLACE "^\\(([^#)]+).*" "\\1" target "${link}")
    string(REGEX REPLACE "^\\([^#)]*(#[^)]*)?\\)$" "\\1" anchor "${link}")
    get_filename_component(absolute "${root}/docs/wiki/${target}" ABSOLUTE)
    file(RELATIVE_PATH relative "${root}" "${absolute}")
    if(relative MATCHES "^\\.\\./" OR NOT EXISTS "${absolute}")
      message(FATAL_ERROR "Broken repository link ${link} in ${page}")
    endif()
    if(relative MATCHES "\\.(png|svg|gif|jpg|jpeg|webp)$")
      set(base "https://raw.githubusercontent.com/atomicdeploy/portable-shell/main")
    else()
      set(base "https://github.com/atomicdeploy/portable-shell/blob/main")
    endif()
    string(REPLACE "${link}" "(${base}/${relative}${anchor})" text "${text}")
  endforeach()
  string(REGEX MATCHALL "\\([A-Za-z0-9_-]+\\.md(#[^ )]+)?\\)" links "${text}")
  foreach(link IN LISTS links)
    string(REGEX REPLACE "^\\(([^#)]+).*" "\\1" target "${link}")
    if(NOT EXISTS "${root}/docs/wiki/${target}")
      message(FATAL_ERROR "Broken wiki page link ${link} in ${page}")
    endif()
    string(REPLACE ".md" "" wiki_link "${link}")
    string(REPLACE "${link}" "${wiki_link}" text "${text}")
  endforeach()
  get_filename_component(name "${page}" NAME)
  file(WRITE "${OUTPUT_DIR}/${name}" "${text}")
endforeach()
list(LENGTH pages count)
message(STATUS "Prepared ${count} wiki pages; unmanaged destination pages are untouched")
