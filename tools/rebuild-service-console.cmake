# Build and replay the full consumer catalog. Supply RESVG and FONT to also
# rasterize; otherwise the generated SVGs remain viewable directly.
cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED BUILD_DIR)
  set(BUILD_DIR "${root}/build/service-console")
endif()
if(NOT DEFINED OUTPUT_DIR)
  set(OUTPUT_DIR "${BUILD_DIR}/gallery")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(configure "${CMAKE_COMMAND}" -S "${root}/tools/service-console" -B "${BUILD_DIR}" -DCMAKE_BUILD_TYPE=Release)
if(DEFINED GENERATOR)
  list(APPEND configure -G "${GENERATOR}")
endif()
if(DEFINED C_COMPILER)
  list(APPEND configure "-DCMAKE_C_COMPILER=${C_COMPILER}")
endif()
execute_process(COMMAND ${configure} COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD_DIR}" --config Release COMMAND_ERROR_IS_FATAL ANY)
if(CMAKE_HOST_WIN32)
  set(exe .exe)
endif()
execute_process(COMMAND "${BUILD_DIR}/bin/service_console_checks${exe}" "${OUTPUT_DIR}" COMMAND_ERROR_IS_FATAL ANY)
file(GLOB frames "${OUTPUT_DIR}/*.svg")
list(LENGTH frames count)
if(NOT count EQUAL 95)
  message(FATAL_ERROR "Expected all 95 catalog states, got ${count}")
endif()
set(cards "")
foreach(frame IN LISTS frames)
  get_filename_component(name "${frame}" NAME_WE)
  set(image "${name}.svg")
  if(DEFINED RESVG AND DEFINED FONT)
    set(args --skip-system-fonts --use-font-file "${FONT}")
    if(DEFINED NERD_FONT)
      list(APPEND args --use-font-file "${NERD_FONT}")
    endif()
    execute_process(COMMAND "${RESVG}" ${args} "${frame}" "${OUTPUT_DIR}/${name}.png" COMMAND_ERROR_IS_FATAL ANY)
    set(image "${name}.png")
  endif()
  string(APPEND cards "<article id='${name}'><h2>${name}</h2><a href='${name}.svg'><img loading='lazy' src='${image}' alt='${name}'></a><p><a href='${name}.ansi'>Captured terminal bytes</a></p></article>\n")
endforeach()
file(WRITE "${OUTPUT_DIR}/index.html" "<!doctype html><meta charset='utf-8'><title>PortableShell service console</title><style>body{background:#11151d;color:#e4e8f0;font:16px system-ui;margin:32px}article{max-width:1200px;margin:48px auto}img{width:100%}a{color:#72d6ee}</style><h1>Service console · 95 states</h1><p>Actual PortableShell output, synthetic in-memory data. No remote operations.</p>${cards}")
message(STATUS "Gallery: ${OUTPUT_DIR}/index.html")
