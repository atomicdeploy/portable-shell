add_executable(message_checks "${root}/tests/message_checks.c" "${root}/tests/render.c" "${root}/src/portable_shell.c")
target_include_directories(message_checks PRIVATE "${root}/include")
target_compile_features(message_checks PRIVATE c_std_99)
target_compile_definitions(message_checks PRIVATE PS_REPLAY_ONLY PS_REPLAY_ATTRIBUTES W=64 H=16 PS_REPLAY_SVG_CAPACITY=1000000)
if(MSVC)
  target_compile_options(message_checks PRIVATE /UNDEBUG /W4)
else()
  target_compile_options(message_checks PRIVATE -UNDEBUG -Wall -Wextra -Werror)
endif()
set_target_properties(message_checks PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
