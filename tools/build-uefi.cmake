cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED OUTPUT_DIR)
  set(OUTPUT_DIR "${root}/build/uefi")
endif()
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
if(NOT DEFINED UEFI_CC)
  find_program(UEFI_CC NAMES x86_64-w64-mingw32-gcc gcc REQUIRED)
endif()
execute_process(COMMAND "${UEFI_CC}" -dumpmachine OUTPUT_VARIABLE triple OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT triple MATCHES "^x86_64.*mingw")
  message(FATAL_ERROR "UEFI_CC must be x86_64 MinGW-w64 GCC, got ${triple}")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(flags -std=c99 -Os -Wall -Wextra -Werror -ffreestanding -fno-builtin
  -fno-stack-protector -mno-stack-arg-probe -mno-red-zone -fno-ident
  -ffunction-sections -fdata-sections "-I${root}/include")
if(DEFINED UEFI_CONFIG AND NOT UEFI_CONFIG STREQUAL "")
  if(NOT EXISTS "${UEFI_CONFIG}")
    message(FATAL_ERROR "UEFI_CONFIG must name an existing consumer configuration header")
  endif()
  list(APPEND flags -include "${UEFI_CONFIG}")
endif()
set(sources host/uefi/main.c host/workbench.c compat/device_profile.c ports/memory_runtime.c)
set(objects)
foreach(source IN LISTS sources)
  string(REPLACE "/" "_" object "${source}")
  set(object "${OUTPUT_DIR}/${object}.o")
  execute_process(COMMAND "${UEFI_CC}" ${flags} -c "${root}/${source}" -o "${object}" COMMAND_ERROR_IS_FATAL ANY)
  list(APPEND objects "${object}")
endforeach()
execute_process(COMMAND "${UEFI_CC}" -nostdlib -Wl,--subsystem,10 -Wl,--entry,efi_main
  -Wl,--image-base,0 -Wl,--enable-reloc-section -Wl,--gc-sections -Wl,--strip-all
  "-Wl,-Map,${OUTPUT_DIR}/PortableShell.map" ${objects} -o "${OUTPUT_DIR}/PortableShell.efi" COMMAND_ERROR_IS_FATAL ANY)
file(SIZE "${OUTPUT_DIR}/PortableShell.efi" bytes)
execute_process(COMMAND "${UEFI_CC}" -print-prog-name=objdump OUTPUT_VARIABLE objdump OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${objdump}" -p "${OUTPUT_DIR}/PortableShell.efi" OUTPUT_VARIABLE headers COMMAND_ERROR_IS_FATAL ANY)
if(NOT headers MATCHES "EFI application" OR headers MATCHES "DLL Name:" OR NOT headers MATCHES "DIR64")
  message(FATAL_ERROR "EFI image must have EFI application subsystem, relocations and no imported DLLs")
endif()
file(WRITE "${OUTPUT_DIR}/image-headers.txt" "${headers}")
message(STATUS "Built ${OUTPUT_DIR}/PortableShell.efi (${bytes} bytes); boot acceptance is separate")
