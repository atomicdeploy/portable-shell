# Host-only Markdown reporting; no credentials, network calls, or code evaluation.
cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED REPORT_DIR)
  set(REPORT_DIR build)
endif()
function(safe value result)
  string(REPLACE "&" "&amp;" value "${value}")
  string(REPLACE "<" "&lt;" value "${value}")
  string(REPLACE ">" "&gt;" value "${value}")
  string(REPLACE "|" "&#124;" value "${value}")
  string(REPLACE "`" "&#96;" value "${value}")
  string(REPLACE "\n" " " value "${value}")
  string(REPLACE "\r" " " value "${value}")
  set(${result} "${value}" PARENT_SCOPE)
endfunction()
set(status "$ENV{JOB_STATUS}")
if(status STREQUAL "success")
  set(icon "✅")
elseif(status STREQUAL "failure")
  set(icon "❌")
else()
  set(icon "⚠️")
endif()
foreach(name JOB_STATUS GITHUB_JOB GITHUB_SHA RUNNER_OS BUILD_CONFIGURATION)
  safe("$ENV{${name}}" ${name})
endforeach()
set(md "# ${icon} PortableShell — ${JOB_STATUS}\n\n## 📦 Build information\n\n| Property | Value |\n| --- | --- |\n| Job | ${GITHUB_JOB} |\n| Runner | ${RUNNER_OS} |\n| Commit | `${GITHUB_SHA}` |\n| Configuration | ${BUILD_CONFIGURATION} |\n\n## 🧪 Step results\n\n| Step | Outcome |\n| --- | --- |\n")
set(steps "$ENV{STEPS_JSON}")
if(steps STREQUAL "")
  set(steps "{}")
endif()
string(JSON count LENGTH "${steps}")
if(count GREATER 0)
  math(EXPR last "${count}-1")
  foreach(i RANGE 0 ${last})
    string(JSON key MEMBER "${steps}" ${i})
    string(JSON outcome GET "${steps}" "${key}" outcome)
    safe("${key}" label)
    safe("${outcome}" outcome)
    string(APPEND md "| ${label} | ${outcome} |\n")
  endforeach()
endif()
string(APPEND md "\n## 🔐 Artifact integrity\n\n| File | Bytes | SHA-256 |\n| --- | ---: | --- |\n")
set(manifest "")
file(GLOB binaries "${REPORT_DIR}/PortableShell" "${REPORT_DIR}/PortableShell.exe" "${REPORT_DIR}/libportable_shell*.a" "${REPORT_DIR}/micro.o")
foreach(path IN LISTS binaries)
  file(SIZE "${path}" bytes)
  file(SHA256 "${path}" sha)
  get_filename_component(name "${path}" NAME)
  string(APPEND md "| ${name} | ${bytes} | `${sha}` |\n")
  string(APPEND manifest "${sha}  ${name}\n")
endforeach()
if(NOT binaries)
  string(APPEND md "| No binary produced by this job | — | — |\n")
endif()
if(EXISTS "${REPORT_DIR}/session-profile.txt")
  file(READ "${REPORT_DIR}/session-profile.txt" profile)
  safe("${profile}" profile)
  string(APPEND md "\n## 💾 Runtime profile\n\n${profile}\n\nSession storage excludes adapter/process memory and stack. It is not a device measurement.\n")
endif()
set(url "$ENV{ARTIFACT_URL}")
if(url MATCHES "^https://github.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[0-9]+/artifacts/[0-9]+$")
  string(APPEND md "\n📥 [Download job artifacts](${url})\n")
endif()
string(APPEND md "\nBuild, test and scan results do not establish hardware or human acceptance.\n")
file(MAKE_DIRECTORY "${REPORT_DIR}")
file(WRITE "${REPORT_DIR}/summary.md" "${md}")
file(WRITE "${REPORT_DIR}/SHA256SUMS" "${manifest}")
if(NOT APPEND_SUMMARY STREQUAL "OFF" AND NOT "$ENV{GITHUB_STEP_SUMMARY}" STREQUAL "")
  file(APPEND "$ENV{GITHUB_STEP_SUMMARY}" "${md}")
endif()
