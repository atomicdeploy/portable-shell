cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED REPORT_DIR)
  set(REPORT_DIR build)
endif()
set(exe "${REPORT_DIR}/PortableShell")
if(CMAKE_HOST_WIN32)
  string(APPEND exe ".exe")
endif()
if(EXISTS "${exe}")
  execute_process(COMMAND "${exe}" --batch --command status OUTPUT_VARIABLE profile RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Runtime profile failed: ${result}")
  endif()
  file(WRITE "${REPORT_DIR}/session-profile.txt" "${profile}")
endif()
