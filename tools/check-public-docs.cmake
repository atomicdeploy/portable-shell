cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(STRINGS "${root}/docs/provenance/reserved-source-names.txt" source_names)
file(GLOB public_docs "${root}/*.md")
file(GLOB wiki_docs "${root}/docs/wiki/*.md")
set(public_files ${public_docs} ${wiki_docs} "${root}/CMakeLists.txt")
foreach(dir include src host ports examples cmake tools)
  file(GLOB_RECURSE entries LIST_DIRECTORIES false "${root}/${dir}/*")
  list(APPEND public_files ${entries})
endforeach()
foreach(path IN LISTS public_files)
  file(READ "${path}" content)
  string(TOLOWER "${content}" content)
  string(TOLOWER "${path}" lower_path)
  foreach(name IN LISTS source_names)
    string(TOLOWER "${name}" lower_name)
    string(FIND "${content}" "${lower_name}" occurrence)
    string(FIND "${lower_path}" "${lower_name}" path_occurrence)
    if(NOT occurrence EQUAL -1 OR NOT path_occurrence EQUAL -1)
      message(FATAL_ERROR "Source identity belongs in provenance, not public branding: ${path}")
    endif()
  endforeach()
endforeach()
# Check actual Markdown links, including the relocated historical documents.
file(GLOB_RECURSE documents "${root}/docs/*.md")
list(APPEND documents ${public_docs})
foreach(path IN LISTS documents)
  file(READ "${path}" content)
  string(REGEX MATCHALL "\\[[^]\n]*\\]\\([^ )]+\\)" links "${content}")
  get_filename_component(directory "${path}" DIRECTORY)
  foreach(link IN LISTS links)
    string(REGEX REPLACE "^.*\\]\\(([^)]+)\\)$" "\\1" link "${link}")
    if(link MATCHES "^([A-Za-z]+:|#|/)")
      continue()
    endif()
    string(REGEX REPLACE "#.*$" "" link "${link}")
    if(NOT EXISTS "${directory}/${link}")
      message(FATAL_ERROR "Broken local documentation link in ${path}: ${link}")
    endif()
  endforeach()
endforeach()
message(STATUS "Public naming and local documentation links verified")
